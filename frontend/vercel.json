{
  "routes": [
    { "handle": "filesystem" },

    { "src": "^/ifsc/([A-Za-z0-9]+)$",                    "dest": "/api/render?path=/ifsc/$1" },
    { "src": "^/bank/([^/]+)$",                          "dest": "/api/render?path=/bank/$1" },
    { "src": "^/state/([^/]+)/([^/]+)$",                 "dest": "/api/render?path=/state/$1/$2" },
    { "src": "^/city/([^/]+)/([^/]+)/([^/]+)$",          "dest": "/api/render?path=/city/$1/$2/$3" },
    { "src": "^/money-guides/([^/]+)$",                  "dest": "/api/render?path=/money-guides/$1" },
    { "src": "^/pin/([0-9]{6})$",                        "dest": "/api/render?path=/pin/$1" },
    { "src": "^/gold-rate-today$",                       "dest": "/api/render?path=/gold-rate-today" },
    { "src": "^/gold-rate-today/([a-z-]+)$",             "dest": "/api/render?path=/gold-rate-today/$1" },
    { "src": "^/fd-rates$",                              "dest": "/api/render?path=/fd-rates" },
    { "src": "^/savings-rates$",                         "dest": "/api/render?path=/savings-rates" },
    { "src": "^/currency-converter$",                    "dest": "/api/render?path=/currency-converter" },
    { "src": "^/swift-code-lookup$",                     "dest": "/api/render?path=/swift-code-lookup" },
    { "src": "^/bank-holidays$",                         "dest": "/api/render?path=/bank-holidays" },

    { "src": "^/sitemap.xml$", "dest": "https://api.rupeepedia.in/sitemap.xml" },
    { "src": "^/sitemap-static.xml$", "dest": "https://api.rupeepedia.in/sitemap-static.xml" },
    { "src": "^/sitemap-calculators.xml$", "dest": "https://api.rupeepedia.in/sitemap-calculators.xml" },
    { "src": "^/sitemap-ifsc-1.xml$", "dest": "https://api.rupeepedia.in/sitemap-ifsc-1.xml" },
    { "src": "^/sitemap-ifsc-2.xml$", "dest": "https://api.rupeepedia.in/sitemap-ifsc-2.xml" },
    { "src": "^/sitemap-ifsc-3.xml$", "dest": "https://api.rupeepedia.in/sitemap-ifsc-3.xml" },
    { "src": "^/sitemap-ifsc-4.xml$", "dest": "https://api.rupeepedia.in/sitemap-ifsc-4.xml" },
    { "src": "^/sitemap-banks.xml$", "dest": "https://api.rupeepedia.in/sitemap-banks.xml" },
    { "src": "^/sitemap-blogs.xml$", "dest": "https://api.rupeepedia.in/sitemap-blogs.xml" },
    { "src": "^/sitemap-pin.xml$", "dest": "https://api.rupeepedia.in/sitemap-pin.xml" },
    { "src": "^/sitemap-credit-cards.xml$", "dest": "https://api.rupeepedia.in/sitemap-credit-cards.xml" },
    { "src": "^/robots.txt$", "dest": "https://api.rupeepedia.in/robots.txt" },

    { "src": ".*", "dest": "/index.html" }
  ]
}